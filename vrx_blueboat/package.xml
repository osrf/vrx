<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>vrx_blueboat</name>
  <version>0.0.0</version>
  <description>
    Blue Robotics BlueBoat USV models and accessory mesh library, used as a
    sandbox for testing mesh geometry, PBR materials and part assembly in
    Gazebo. Assets only - no compiled code.
  </description>
  <maintainer email="bbingham@honurobotics.com">Brian Bingham</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- The models load vrx-surface-system and vrx-simple-hydrodynamics-system
       at runtime. -->
  <exec_depend>vrx_usv_dynamics</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
