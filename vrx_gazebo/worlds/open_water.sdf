<?xml version="1.0"?>
<sdf version="1.12">
  <world name="default">

    <!-- Physics -->
    <physics name="default_physics" type="dart">
      <max_step_size>0.004</max_step_size>
      <!-- <real_time_factor>0</real_time_factor> -->
    </physics>

    <!-- Spherical coordinates for Portuguese Ledge, Monterey Bay.
         Required by the magnetometer system, which computes the magnetic field
         from the World Magnetic Model (WMM) at the given lat/lon. -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>36.693509</latitude_deg>
      <longitude_deg>-121.936568</longitude_deg>
      <elevation>0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <!-- Scene: deep ocean ambient + procedural sky. The <sky> element
         tells gz-rendering to draw its built-in procedural sky cube
         (sun, horizon transition) so the water has something to
         reflect and the background isn't a flat colour. -->
    <scene>
      <ambient>0.0 1.0 1.0</ambient>
      <background>0.0 0.7 0.8</background>
      <sky></sky>
      <grid>false</grid>
    </scene>

    <!-- Directional light (sun, attenuated by water) -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 20 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.5 0.5 0.5 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Core systems -->
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>

    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>

    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>

    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
    </plugin>

    <plugin
      filename="gz-sim-magnetometer-system"
      name="gz::sim::systems::Magnetometer">
      <use_units_gauss>false</use_units_gauss>
      <use_earth_frame_ned>false</use_earth_frame_ned>
    </plugin>

    <plugin
      filename="gz-sim-imu-system"
      name="gz::sim::systems::Imu">
    </plugin>

    <!-- NOTE: gz-sim's graded_buoyancy models a FLAT water plane at Z=0 and
         does not couple to the wavefield. With no <enable> scoping it also acts
         on test_buoy's collision, and its force (full submerged volume) far
         exceeds WaveBuoyancy's point forces — so it pins the buoy to the still
         surface and masks all wave excitation. test_buoy supplies its own
         wave-coupled buoyancy via gz-sim-wave-buoyancy-system, so we disable the
         static graded buoyancy here to let the buoy bob with the waves. If you
         add vessels that rely on standard buoyancy, re-enable this and scope it
         away from wave-buoyancy models with <enable>...</enable>. -->
    <!--
    <plugin
      filename="gz-sim-buoyancy-system"
      name="gz::sim::systems::Buoyancy">
      <graded_buoyancy>
        <default_density>1025</default_density>
        <density_change>
          <above_depth>0</above_depth>
          <density>1</density>
        </density_change>
      </graded_buoyancy>
    </plugin>
    -->

    <!-- ==================================================================
         WAVE SOURCE — the engine is the plugin's identity. Keep exactly ONE of
         the two <plugin> blocks below active and comment the other out. Both
         blocks are deliberately comment-free so either can be wrapped in an XML
         comment cleanly (XML comments cannot nest). Per-parameter notes live in
         the comment directly above each block.
         ================================================================== -->

    <!-- FFT engine (gz-sim-waves-fft-system): stochastic spectral ocean —
         EncinoWaves spectra (TMA + Hasselmann + capillary) by default, in-tree
         Phillips when not built with encino. Parameters:
           sea_state  optional WMO sea state code (0-9). When set it overrides
                      period and gain to reproduce that sea's significant wave
                      height + peak period (WMO code table 3700;
                      en.wikipedia.org/wiki/Sea_state). e.g. 3 slight, 5 rough.
           period     sea state; the engine derives wind speed (3.2 → ~5 m/s).
           gain       visual amplitude multiplier on top of Encino's Hs
                      calibration. 9.5 (~1/ampCalib) gives the dramatic look and
                      is intentionally unphysical; for a calmer sea raise period
                      and drop gain toward 1.0.
           direction  wind heading [rad] (2.356 = 135°). Used by the Phillips
                      fallback; the default Encino path does NOT yet read it.
           tau        startup ramp time constant [s].
           tile_size  periodic tile extent [m]; larger leaves room for swells.
           grid_size  FFT/IFFT resolution (power of two).
           seed       spectrum RNG seed.
           choppiness Tessendorf horizontal crest displacement (visual layer);
                      negative pinches crests (asv_wave_sim steepness 2 = -2).
    -->
    <plugin filename="gz-sim-waves-fft-system"
            name="gz::sim::systems::FftWaves">
      <update_rate>30</update_rate>
      <wave>
        <period>3.2</period>
        <gain>9.5</gain>
        <direction>2.356</direction>
        <tau>2.0</tau>
        <tile_size>256</tile_size>
        <grid_size>128</grid_size>
        <seed>42</seed>
        <choppiness>-2.0</choppiness>
      </wave>
    </plugin>

    <!-- Gerstner engine (gz-sim-waves-gerstner-system): analytic sum of
         component waves. To use it, comment the FFT <plugin> above out and
         remove the comment wrapper around the <plugin> below. Parameters:
           sea_state  optional WMO sea state code (0-9); overrides period+gain
                      to that sea's wave height (see the FFT block above).
           model      PMS (wind-derived) or CWR (constant amplitude; then also
                      add an <amplitude> element).
           number     count of component waves summed.
           period     mean wave period [s].
           direction  mean wave heading [rad].
           angle      angular spread of the components about direction [rad].
           scale      amplitude/length ratio between mean and extreme waves.
           steepness  crest sharpness in [0,1]; 0 is round swell, 1 is pinched.
           gain       amplitude multiplier.
           tau        startup ramp time constant [s].
           grid_size  resolution it samples itself onto for the visual.
         It ignores the FFT-only knobs (tile_size, seed, choppiness). Values
         below are a starting point; tune gain and steepness to taste.
    -->
    <!--
    <plugin filename="gz-sim-waves-gerstner-system"
            name="gz::sim::systems::GerstnerWaves">
      <update_rate>30</update_rate>
      <wave>
        <model>PMS</model>
        <number>3</number>
        <period>3.2</period>
        <direction>2.356</direction>
        <angle>0.4</angle>
        <scale>1.1</scale>
        <steepness>0.5</steepness>
        <gain>1.0</gain>
        <tau>2.0</tau>
        <grid_size>128</grid_size>
      </wave>
    </plugin>
    -->

    <!-- GUI -->
    <gui fullscreen="0">
      <!-- 3D scene -->
      <plugin filename="MinimalScene" name="3D View">
        <gz-gui>
          <title>3D View</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.4 0.4 0.4</ambient_light>
        <background_color>0.0 0.7 0.8</background_color>
        <!-- Matches asv_wave_sim's reference camera_pose for fair
             side-by-side visual comparison: 6m east of origin, 6m
             above water, pitched ~29° down. -->
        <camera_pose>-6 0 6 0 0.5 0</camera_pose>
        <camera_clip>
          <near>0.1</near>
          <far>50000</far>
        </camera_clip>
      </plugin>

      <!-- Scene management plugins -->
      <plugin filename="EntityContextMenuPlugin" name="Entity context menu">
        <gz-gui>
          <property key="state" type="string">floating</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>

      <plugin filename="GzSceneManager" name="Scene Manager">
        <gz-gui>
          <anchors target="3D View">
            <line own="right" target="right"/>
            <line own="top" target="top"/>
          </anchors>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>

      <plugin filename="InteractiveViewControl" name="Interactive view control">
        <gz-gui>
          <anchors target="3D View">
            <line own="right" target="right"/>
            <line own="top" target="top"/>
          </anchors>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>

      <plugin filename="CameraTracking" name="Camera Tracking">
        <gz-gui>
          <anchors target="3D View">
            <line own="right" target="right"/>
            <line own="top" target="top"/>
          </anchors>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>

      <plugin filename="MarkerManager" name="Marker manager">
        <gz-gui>
          <anchors target="3D View">
            <line own="right" target="right"/>
            <line own="top" target="top"/>
          </anchors>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
        <warn_on_action_failure>false</warn_on_action_failure>
      </plugin>

      <plugin filename="SelectEntities" name="Select Entities">
        <gz-gui>
          <anchors target="3D View">
            <line own="right" target="right"/>
            <line own="top" target="top"/>
          </anchors>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>

      <plugin filename="VisualizationCapabilities" name="Visualization Capabilities">
        <gz-gui>
          <anchors target="3D View">
            <line own="right" target="right"/>
            <line own="top" target="top"/>
          </anchors>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>

      <plugin filename="Spawn" name="Spawn Entities">
        <gz-gui>
          <anchors target="3D View">
            <line own="right" target="right"/>
            <line own="top" target="top"/>
          </anchors>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>

      <!-- World control -->
      <plugin filename="WorldControl" name="World control">
        <gz-gui>
          <title>World control</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">72</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="left" target="left"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </gz-gui>
        <play_pause>true</play_pause>
        <step>true</step>
        <start_paused>false</start_paused>
      </plugin>

      <!-- World statistics -->
      <plugin filename="WorldStats" name="World stats">
        <gz-gui>
          <title>World stats</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">110</property>
          <property type="double" key="width">290</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="right" target="right"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </gz-gui>
        <sim_time>true</sim_time>
        <real_time>true</real_time>
        <real_time_factor>true</real_time_factor>
        <iterations>true</iterations>
      </plugin>

      <plugin filename="ComponentInspector" name="Component Inspector">
        <gz-gui>
          <title>Inspector</title>
          <property type="string" key="state">docked_collapsed</property>
        </gz-gui>
      </plugin>
    </gui>

    <!-- Water surface visual (Gerstner-shader-displaced mesh). -->
    <include>
      <uri>model://water_surface</uri>
    </include>

    <!-- Test buoy: stubby horizontal cylinder with WaveBuoyancy attached.
         Floats and bobs on the wavefield. -->
    <include>
      <name>test_buoy</name>
      <pose>0 0 2 0 0 0</pose>
      <uri>model://test_buoy</uri>
    </include>

  </world>
</sdf>
