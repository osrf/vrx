<?xml version="1.0"?>
<sdf version="1.10">
  <model name="water_surface">
    <static>true</static>
    <link name="link">
      <visual name="water">
        <geometry>
          <mesh>
            <uri>meshes/water.dae</uri>
          </mesh>
        </geometry>
        <plugin filename="gz-sim-water-visual-system"
                name="gz::sim::systems::WaterVisual">
          <shader>
            <vertex>shaders/gerstner_waves_vs_330.glsl</vertex>
            <fft_vertex>shaders/fft_water_vs_330.glsl</fft_vertex>
            <fragment>shaders/water_fs_330.glsl</fragment>
            <!-- GPU-FFT compute shader (used when GZ_WAVES_GPU_FFT=1).
                 Stage 1 ships with a hello-world procedural pattern;
                 Stages 2-3 replace it with the real FFT pipeline. -->
            <gpu_compute>shaders/compute/hello_world.glsl</gpu_compute>
            <!-- Stage 2 evolve shaders: write h(k, t) (packed with
                 Dx(k, t)) and Dy(k, t) to GPU textures each frame,
                 reading h0 uploaded once at init. ω is computed
                 in-shader. -->
            <gpu_evolve>shaders/compute/evolve.glsl</gpu_evolve>
            <gpu_evolve_dy>shaders/compute/evolve_dy.glsl</gpu_evolve_dy>
            <!-- Stage 3 GPU IFFT: bit-reversal permutation +
                 Cooley-Tukey butterfly. Together these run a 2D IFFT
                 over h(k, t), producing the spatial η(x, y, t). The
                 butterfly carries two complex signals per RGBA texel,
                 so a single pipeline handles (η, Dx); Dy uses a
                 second instance of the same pipeline. -->
            <gpu_ifft_bitreverse>shaders/compute/fft_bitreverse.glsl</gpu_ifft_bitreverse>
            <gpu_ifft_butterfly>shaders/compute/fft_butterfly.glsl</gpu_ifft_butterfly>
            <!-- Stage 4 combine: assemble the two IFFT outputs into the
                 (η, Dx, Dy, _) layout the vertex shader expects. Two
                 passes because OgreNext's OpenGL compute path can't
                 bind two texture samplers reliably in one dispatch. -->
            <gpu_combine_eta_dx>shaders/compute/combine_displacement.glsl</gpu_combine_eta_dx>
            <gpu_combine_dy>shaders/compute/combine_displacement_dy.glsl</gpu_combine_dy>
            <!-- Diagnostic: naive O(N²) 2D IFFT reference
                 implementation. Enable with
                 GZ_WAVES_GPU_FFT_NAIVE=1 to bypass the radix-2
                 Cooley-Tukey pipeline and run a brute-force IFFT
                 instead. -->
            <gpu_ifft_naive>shaders/compute/fft_naive.glsl</gpu_ifft_naive>
            <!-- Diagnostic: writes a moving sine wave straight into
                 ifftFinalTex, bypassing the IFFT. Used with the
                 GZ_WAVES_GPU_FFT_TEST_PATTERN=1 env var to isolate
                 binding/sampling bugs from compute bugs. -->
            <gpu_test_pattern>shaders/compute/debug_pattern.glsl</gpu_test_pattern>
            <gpu_view_hkt>shaders/compute/debug_view_hkt.glsl</gpu_view_hkt>
            <parameters>
              <rescale>0.5</rescale>
              <bumpScale>50 50</bumpScale>
              <bumpSpeed>0.01 0.01</bumpSpeed>
              <hdrMultiplier>0.4</hdrMultiplier>
              <fresnelPower>5.0</fresnelPower>
              <shallowColor>0 0.1 0.3 1.0</shallowColor>
              <deepColor>0 0.05 0.2 1.0</deepColor>
            </parameters>
          </shader>
          <textures>
            <bumpMap>textures/wave_normals.dds</bumpMap>
            <cubeMap>textures/skybox_lowres.dds</cubeMap>
          </textures>
        </plugin>
      </visual>
    </link>
  </model>
</sdf>
