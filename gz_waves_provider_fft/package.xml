<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>gz_waves_provider_fft</name>
  <version>0.0.0</version>
  <description>
    Stochastic FFT wave-field engine for gz_waves: the Apache-2.0 EncinoWaves
    spectra (TMA/JONSWAP + directional spreading) by default, or an in-tree
    Tessendorf/Phillips spectral ocean when not built with encino. Provides the
    IWaveField engine library and the gz-sim-waves-fft-system plugin.
  </description>
  <maintainer email="cen.aguero@gmail.com">Carlos Agüero</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>gz_waves</depend>
  <depend>gz_sim_vendor</depend>
  <depend>gz_math_vendor</depend>
  <depend>gz_plugin_vendor</depend>
  <depend>eigen</depend>
  <!-- Apache-2.0 Horvath ocean spectrum library — the default FFT spectrum.
       OPTIONAL: if absent, the engine builds Phillips-only (no encino dep).
       Kept here so colcon orders the encino build first when it IS present. -->
  <depend>encinowaves_vendor</depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
