<launch>

  <!-- EGL headless-rendering launch path.

       The ros_gz_sim gz_server action (3.0.8) has no passthrough for the
       gz sim headless-rendering flag, so start the server through
       ros_gz_sim's gz_sim.launch.py, whose gz_args forwards the full
       gz sim command line. This selects the EGL render backend so the
       Sensors system renders without an X server. -->

  <arg name="world" default="open_water.sdf" description="World SDF file name (resolved via GZ_SIM_RESOURCE_PATH)"/>

  <include file="$(find-pkg-share ros_gz_sim)/launch/gz_sim.launch.py">
    <arg name="gz_args"
         value="-r -s -v4 --headless-rendering --render-engine-server ogre2 --render-engine-server-api-backend opengl $(var world)"/>
  </include>

  <!-- ROS <-> Gazebo bridge. gz runs as its own process here (not a composable
       node), so run the bridge as a standalone node rather than loading it into
       a shared container. -->
  <ros_gz_bridge
      bridge_name="ros_gz_bridge"
      config_file="$(find-pkg-share vrx_bringup)/config/ros_gz_bridge.yaml"
      use_composition="false">
  </ros_gz_bridge>

</launch>
