<launch>

  <!-- Controlled smoke launch: GLX vs EGL with everything else held equal.

       Both the xvfb (GLX) and egl (headless) smoke backends use THIS file so the
       only difference between them is the gz headless-rendering flag. Same
       process topology (standalone gz sim via ros_gz_sim's gz_sim.launch.py),
       same render engine (ogre2), same verbosity (-v1), same standalone bridge.
       That makes the camera-FPS numbers an apples-to-apples GLX-vs-EGL compare.

       The composable ros_gz_sim gz_server action (3.0.8) has no passthrough for
       the headless-rendering flag, so the standalone gz_sim.launch.py path is the
       only one that can serve both backends identically. -->

  <arg name="world" default="open_water.sdf" description="World SDF file name (resolved via GZ_SIM_RESOURCE_PATH)"/>
  <arg name="headless_rendering" default="false" description="Use headless rendering (no X server) instead of GLX"/>
  <arg name="api_backend" default="opengl" description="Headless graphics API backend: opengl (EGL+llvmpipe) or vulkan (lavapipe)"/>

  <!-- GLX path: no headless-rendering flag; renders against an X server (Xvfb). -->
  <include file="$(find-pkg-share ros_gz_sim)/launch/gz_sim.launch.py" unless="$(var headless_rendering)">
    <arg name="gz_args"
         value="-r -s -v1 --render-engine-server ogre2 $(var world)"/>
  </include>

  <!-- Headless path: identical command line plus the headless-rendering flag and
       the selected API backend (opengl -> EGL+llvmpipe, vulkan -> lavapipe). -->
  <include file="$(find-pkg-share ros_gz_sim)/launch/gz_sim.launch.py" if="$(var headless_rendering)">
    <arg name="gz_args"
         value="-r -s -v1 --render-engine-server ogre2 --headless-rendering --render-engine-server-api-backend $(var api_backend) $(var world)"/>
  </include>

  <!-- ROS <-> Gazebo bridge. gz runs as its own process here (not a composable
       node), so run the bridge as a standalone node rather than loading it into
       a shared container. Identical for both backends. -->
  <ros_gz_bridge
      bridge_name="ros_gz_bridge"
      config_file="$(find-pkg-share vrx_bringup)/config/ros_gz_bridge.yaml"
      use_composition="false">
  </ros_gz_bridge>

</launch>
